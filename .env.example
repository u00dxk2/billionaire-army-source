# Environment variables used by Billionaire Army. Copy to `.env` and fill in
# what you need. Never commit a real value. Every value below is a placeholder.

# --- Database and auth (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# --- API (packages/api) ---
API_PORT=3001
API_HOST=0.0.0.0
# Allowed CORS origin for the web app (optional; defaults to http://localhost:3000)
WEB_ORIGIN=
# Comma-separated Supabase user ids allowed into /admin (optional; empty = no admins)
ADMIN_USER_IDS=

# --- Web (packages/web; Next.js reads NEXT_PUBLIC_* at build time) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_URL=http://localhost:3001
# Public base URL used in share links (optional)
NEXT_PUBLIC_SITE_URL=
# "1" makes the home page lead with a feed card instead of the default hero (optional)
NEXT_PUBLIC_HERO_RECEIPT=
# Pin one feed item id as the home hero card (optional; leave unset normally)
NEXT_PUBLIC_HERO_FEATURED_ID=
# Set to "0" to turn off one-card-per-person dedup on /feed (optional)
NEXT_PUBLIC_FEED_DEDUP=

# --- Optional third-party services ---
SERPER_API_KEY=
FIRECRAWL_API_KEY=
SENDGRID_API_KEY=
SENTRY_DSN=
AMPLITUDE_API_KEY=

# --- Data pipeline (packages/jobs) ---
FEC_API_KEY=
NEWSAPI_KEY=
OPENAI_API_KEY=
# Only needed if you point a model seat at a Claude model
ANTHROPIC_API_KEY=
# Contact email sent in the SEC EDGAR User-Agent (SEC asks for one)
CONTACT_EMAIL=
# GDELT fetcher stops after this many minutes (default 150; set low for a quick local run)
GDELT_TIME_BUDGET_MINUTES=
# Cost-logging rates in USD per million tokens
OPENAI_INPUT_COST_PER_MTOK=
OPENAI_OUTPUT_COST_PER_MTOK=
# Per-step model overrides (defaults come from model-seats.json)
CURATOR_MODEL=
CURATOR_VERIFIER_MODEL=
SUMMARY_MODEL=
# Drop news articles older than this many days before curation (default 14)
CURATOR_MAX_INGEST_AGE_DAYS=
# "1" runs the full feed curator without writing to the database
CURATOR_DRY_RUN=


# --- Optional LLM-call log (off unless LLM_CALL_LOG_URL is set) ---
# Endpoint that receives one JSON row per model call (model, call site, status,
# token counts, latency; no prompt or response text). No built-in destination.
LLM_CALL_LOG_URL=
# Optional value sent as "pin" in each row, for sinks that authenticate that way
LLM_CALL_LOG_PIN=
# "1" turns the log off even when LLM_CALL_LOG_URL is set
LLM_CALL_LOG_DISABLED=

# --- Checkers (packages/jobs/src/check-*.ts) ---
# API base for check:card-badge (required by that checker; no default)
BA_API_URL=
# Site base for check:giving-caveat and check:fec-withheld (default https://billionaire.army)
BA_SITE_BASE=

# The pipeline also reads a number of optional tuning flags (CURATOR_*, SUMMARY_*,
# PROFILE_DRY_RUN, ...). Each is documented where it is read in packages/jobs/src.
